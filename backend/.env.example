# Required
JWT_SECRET=your-very-secret-key-change-in-production

# Required for AI coaching features (Epic 5)
MISTRAL_API_KEY=your-mistral-api-key

# Database (default: SQLite local)
DATABASE_URL=sqlite+aiosqlite:///./secondserve.db

# Debug mode (set to true only in development)
DEBUG=false

# Port d'écoute uvicorn (changer si conflit avec d'autres services)
PORT=8000

MONITOR_DB_URL=sqlite+aiosqlite:///./monitor.db
MONITOR_USER=admin
MONITOR_PASSWORD=changeme-secure

# Partage de lien live (feature live_sharing)
PUBLIC_WEB_BASE_URL=https://secondserve.app
WEB_CORS_ORIGIN=https://secondserve.app
