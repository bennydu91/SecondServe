<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Déclarées dans ce module car DataLayerListener y poste une notification
         full-screen-intent pour ouvrir l'écran de match au démarrage d'une session
         depuis la montre. Ces permissions fusionnent vers les apps consommatrices. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />

</manifest>
